# Configuración general de la app
VIRTUAL_EMPLOYEE_ADMIN_KEY=tu_clave_admin_secreta
VIRTUAL_EMPLOYEE_ADMIN_EMAIL=admin@tuempresa.com
VIRTUAL_EMPLOYEE_DATABASE=./virtual_employee.db

# OpenAI
OPENAI_API_KEY=tu_api_key_de_openai
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Meta
META_WHATSAPP_TOKEN=tu_token_meta
META_WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
